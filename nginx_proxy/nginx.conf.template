user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # SSL configuration applied to all HTTPS server blocks
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # One SAN certificate covers api./app./admin./apex/www of __DOMAIN__.
    ssl_certificate     /etc/nginx/ssl/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/__DOMAIN__/privkey.pem;

    upstream backend_server  { server backend:8000; }      # Django (Gunicorn)
    upstream admin_frontend  { server frontend:80; }       # Admin CRM (static)
    upstream player_frontend { server player_portal:80; }  # Player portal (static)

    # --- HTTP :80 — ACME challenge + redirect everything to HTTPS ------------
    server {
        listen 80;
        server_name api.__DOMAIN__ app.__DOMAIN__ admin.__DOMAIN__ __DOMAIN__ www.__DOMAIN__;

        # Let's Encrypt webroot (shared with the certbot container/host).
        location /.well-known/acme-challenge/ {
            root /var/www/letsencrypt;
            default_type "text/plain";
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # --- api.__DOMAIN__ — Django backend, static, media, Meta webhook/flows --
    server {
        listen 443 ssl;
        http2 on;
        server_name api.__DOMAIN__;

        location /static/ {
            alias /srv/www/static/;
            expires 7d;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
        }

        location /media/ {
            alias /app/media/;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
            expires 30d;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin * always;
                add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
                add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Range" always;
                add_header Content-Length 0;
                add_header Content-Type text/plain;
                return 204;
            }
        }

        location / {
            proxy_pass http://backend_server;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_buffering off;
        }
    }

    # --- app.__DOMAIN__ — player portal (SPA) --------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name app.__DOMAIN__;

        location / {
            proxy_pass http://player_frontend;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
        }
    }

    # --- admin.__DOMAIN__ — admin CRM (SPA) ----------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name admin.__DOMAIN__;

        location / {
            proxy_pass http://admin_frontend;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
        }
    }

    # --- apex + www — send visitors to the player portal ---------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name __DOMAIN__ www.__DOMAIN__;
        return 301 https://app.__DOMAIN__$request_uri;
    }
}
